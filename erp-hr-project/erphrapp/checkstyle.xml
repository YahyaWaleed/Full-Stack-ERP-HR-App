<?xml version="1.0"?>
<!DOCTYPE module PUBLIC "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
        "https://checkstyle.org/dtds/configuration_1_3.dtd">
<!-- a deliberately small rule set: the defects the code review found by hand (review 5.10) -->
<module name="Checker">
    <property name="severity" value="warning"/>
    <module name="TreeWalker">
        <module name="UnusedImports"/>
        <module name="RedundantImport"/>
        <module name="EmptyStatement"/>          <!-- stray ;; -->
        <module name="IllegalImport">            <!-- e.g. Swagger's @RequestBody instead of Spring's -->
            <property name="illegalClasses" value="io.swagger.v3.oas.annotations.parameters.RequestBody, jakarta.transaction.Transactional"/>
        </module>
        <module name="EqualsHashCode"/>
        <module name="StringLiteralEquality"/>
        <module name="OneStatementPerLine"/>
        <module name="UpperEll"/>
    </module>
</module>
