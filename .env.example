# Copy to .env (never commit .env) and fill in. Used by docker-compose.yml.

# MySQL root password (only used by the database container itself)
DB_ROOT_PASSWORD=
# The application's own database account (created automatically; not root)
DB_USERNAME=erp_app
DB_PASSWORD=

# at least 32 random characters, e.g. from:  openssl rand -base64 48
JWT_SECRET=

# BCrypt hash of the first 'admin' password -- the plain password never goes in a file:
#   docker run --rm httpd:2.4-alpine htpasswd -bnBC 10 "" 'your-password' | tr -d ':\n'
# In .env, write every $ as $$ (docker compose treats $ as a variable), e.g. $$2y$$10$$abc...
ADMIN_PASSWORD_HASH=

# dev = demo employees and payroll history; prod = empty company, reference data only
SPRING_PROFILES_ACTIVE=dev

# host port for the API (the app itself reaches it through nginx on :3000)
BACKEND_PORT=8080
